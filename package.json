{
  "name": "food-fight-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Food Fight Arena — real-time 3D brawler in Three.js",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
