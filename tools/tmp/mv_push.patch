+// ─────────────────────────────────────────────────────────────────────────────
+// DISPLACEMENT — the primitive that moves a fighter it did not ask to move
+//
+// `movement.ts:escapeCover` below has been waiting for this since it was written. Its own
+// header says the "fighter inside a prop" state is *"the worst shape a bug can have —
+// total, silent, and indistinguishable from 'the controls stopped working'"*, that no
+// player can reach it today because *"spawns are clear and knockback is visual-only"*, and
+// that it *"becomes reachable the moment anyone adds sim-side knockback, a dash, or a
+// pull."* This is that moment, and the recovery is already built: every displacement is
+// spent through `tryMove`, which runs `escapeCover` first.
+// ─────────────────────────────────────────────────────────────────────────────
+
+/**
+ * The largest `damage` any weapon in the roster deals, DERIVED from `CHARACTERS` rather
+ * than typed. It is the denominator of the displacement scale, so a hand-written number
+ * here would silently re-scale every knockback in the game the first time a weapon's
+ * damage moved — and `rules.ts` is the single source of truth for combat.
+ */
+const MAX_WEAPON_DAMAGE = (() => {
+  let m = 0;
+  for (const id of CHARACTER_IDS) {
+    for (const w of CHARACTERS[id].weapons) if (w.damage > m) m = w.damage;
+  }
+  return m;
+})();
+
+/**
+ * ── THE CEILING ON A SINGLE FIGHTER'S PENDING DISPLACEMENT: ONE BODY WIDTH ──
+ *
+ * `PLAYER_SIZE` is the collision box the sim already moves fighters around with, so "the
+ * biggest hit in the game moves you exactly one of yourself" is a sentence a player can
+ * read off the screen. It is also what makes chaining safe: impulses ACCUMULATE into this
+ * cap and never past it, so no sequence of hits can turn into a launch.
+ */
+export const MAX_PUSH_DISTANCE = PLAYER_SIZE;
+
+/** Below this separation there is no bearing between attacker and victim — see `pushFighter`. */
+const PUSH_COINCIDENT_EPS = 1e-6;
+
+/**
+ * How far a hit of `dealt` damage displaces its victim, in world units.
+ *
+ * `PLAYER_SIZE * dealt / MAX_WEAPON_DAMAGE` — the roster's biggest hit is worth exactly one
+ * body width and everything else is linear in damage. **Every term is derived**: there is
+ * no tuning constant here, which matters because `rules.ts` is the single source of truth
+ * for combat and it is not this owner's file. If this ever needs its own dial, the dial
+ * belongs there and this function becomes its only reader.
+ *
+ * ⚠️ `dealt`, NOT the weapon's authored `damage`: `combat.ts:applyDamage` scales by the
+ * attacker's `damageMul`, and the `hit-landed` event carries what the victim actually LOST.
+ * A displacement priced off the authored number would disagree with the damage number
+ * floating over the victim's head, which is `DECISIONS §13`'s class of defect exactly.
+ * A level-15 attacker therefore saturates the cap rather than exceeding it.
+ */
+export function pushDistanceForDamage(dealt: number): number {
+  if (!(dealt > 0) || MAX_WEAPON_DAMAGE <= 0) return 0;
+  return (PLAYER_SIZE * dealt) / MAX_WEAPON_DAMAGE;
+}
+
+/**
+ * Hand `fighter` a displacement of `distance` world units, directly away from
+ * `(fromX, fromY)`.
+ *
+ * ── 🚨 WHY THIS CANNOT BECOME A THIRD LOCK (`DECISIONS §75`, `§80`) ─────────
+ *
+ * `§75` records that slow and stun STACK into a hold — *"you essentially lock him to
+ * place"* — and `§80` is Uri's answer that a super must be DODGEABLE. A displacement that
+ * interrupted movement would be a soft stun and the third member of that family. Three
+ * properties keep it out, and each is a number rather than an intention:
+ *
+ *   1. **CONTROL AUTHORITY IS UNTOUCHED, EXACTLY.** The push is spent in its OWN
+ *      `tryMove` call, after the fighter's own movement has already been resolved in
+ *      `sim.ts`'s loop. The fighter's input therefore buys it the same displacement it
+ *      would have bought with no push in flight — bit-identically, not approximately —
+ *      and `sim.test.mjs` §36 asserts that as a difference of differences.
+ *   2. **IT PUSHES AWAY FROM THE ATTACKER, SO IT STRICTLY HELPS THE DODGE.** The one thing
+ *      `§80` asks of a super is that the target can leave the disc before it resolves.
+ *      Displacement moves the target OUT of the disc; it can never hold anybody inside one.
+ *   3. **IT CANNOT OUT-RUN A WALK BY MORE THAN A HAIR.** The spend rate is exactly
+ *      `PLAYER_SPEED`, the roster-wide movement CAP (`rules.ts:SPEED_TOP_STAT` is a cap,
+ *      not a centre, so `speedFor` can only scale DOWN). A fighter walking straight INTO
+ *      the push is therefore displaced at `PLAYER_SPEED - speedFor(c)` — between 0.0000
+ *      (Sushi and Hot Dog, which sit at the cap) and 0.0144 wu/ms — for at most
+ *      `MAX_PUSH_DISTANCE / PLAYER_SPEED` = 350 ms. **Worst case over an entire maximum
+ *      push: 5.04 wu, 12% of a body.** That is a positional cost, not a lock.
+ *
+ * ⚠️ **NEWEST DIRECTION WINS; DISTANCE ACCUMULATES TO THE CAP.** Blending two directions
+ * can produce the zero vector, which would silently cancel a hit; taking the newest is one
+ * rule, is what "the last blow shoved you" means, and is deterministic because
+ * `applyDamage` is reached in slot order from one loop.
+ *
+ * ⚠️ **AT ZERO SEPARATION THERE IS NO PUSH**, on exactly the reasoning `combat.ts`'s melee
+ * branch already applies to a coincident swing: the vector from attacker to victim is the
+ * zero vector, it points nowhere, and no amount of force can be aimed along it. Choosing a
+ * direction there would be non-determinism smuggled into a sim whose determinism
+ * underwrites every balance number in the project.
+ */
+export function pushFighter(fighter: Fighter, fromX: number, fromY: number, distance: number): void {
+  if (!(distance > 0)) return;
+  const dx = fighter.x - fromX;
+  const dy = fighter.y - fromY;
+  const mag = Math.hypot(dx, dy);
+  if (mag < PUSH_COINCIDENT_EPS) return;
+  const p = fighter.push;
+  p.x = dx / mag;
+  p.y = dy / mag;
+  p.remaining = Math.min(MAX_PUSH_DISTANCE, p.remaining + distance);
+}
+
+/**
+ * Spend this tick's share of `fighter`'s pending displacement. Returns whether it moved.
+ *
+ * ⚠️ **THE BUDGET IS CONSUMED WHETHER OR NOT THE STEP CONNECTS.** `tryMove` refuses a step
+ * into cover, so a fighter shoved against a wall would otherwise HOLD its impulse and fire
+ * off the moment the wall stopped being in the way — a stored shove that goes off later is
+ * exactly the "total, silent" class `escapeCover` exists to prevent, one level up.
+ *
+ * ⚠️ **`tryMove`, NOT A DIRECT WRITE TO `x`/`y`.** That is the whole depenetration
+ * guarantee: `tryMove` runs `escapeCover` before it moves anything, so a fighter that ends
+ * up inside a prop — the state this primitive is what makes reachable — walks back out on
+ * its next attempt instead of freezing forever. `sim.test.mjs` §36 pushes a fighter into
+ * `spice_cart` on purpose and requires it to recover.
+ *
+ * ⚠️ **`remaining` IS SNAPPED TO EXACTLY 0**, and the direction with it, so a spent push
+ * leaves no float dust in the state digest — see `Fighter.push`.
+ */
+export function stepPush(fighter: Fighter, dt: number, arena: ArenaDefinition): boolean {
+  const p = fighter.push;
+  if (p.remaining <= 0) return false;
+  const step = p.remaining < PLAYER_SPEED * dt ? p.remaining : PLAYER_SPEED * dt;
+  p.remaining -= step;
+  const moved = tryMove(fighter, p.x * step, p.y * step, arena);
+  if (p.remaining <= 0) { p.remaining = 0; p.x = 0; p.y = 0; }
+  return moved;
+}
